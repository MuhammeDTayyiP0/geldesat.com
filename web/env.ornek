# GeldeSat ortam değişkenleri — Coolify'da "Environment Variables" bölümüne
# girin; yerelde bu dosyayı .env olarak kopyalayın.

# --- Zorunlu (canlı ortam) ---------------------------------------------------
# Postgres bağlantısı. Canlıda zorunlu; yerelde boş bırakılırsa bellekte
# çalışan PGLite kullanılır (yeniden başlatınca veriler silinir).
DATABASE_URL=postgresql://geldesat:sifre@localhost:5432/geldesat

# Sitenin tam adresi, sonunda / olmadan. HTTPS şart (giriş çerezleri).
BETTER_AUTH_URL=https://www.geldesat.com

# En az 32 karakter rastgele dize, ör: openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Yönetici -----------------------------------------------------------------
# Virgülle ayrılmış e-postalar. Yalnızca doğrulanmış (Google ile giriş ya da
# e-posta doğrulaması yapılmış) hesaplar yönetici olur. Alternatif: SQL ile
#   update profiles set role='ADMIN' where user_id='...';
ADMIN_EMAILS=

# --- Google ile giriş (opsiyonel) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Butonu göstermek için derleme (build) sırasında da tanımlı olmalı.
VITE_GOOGLE_AUTH_ENABLED=false

# --- E-posta (şifre sıfırlama ve e-posta doğrulama için) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GeldeSat <noreply@geldesat.com>"

# --- Mobil uygulama OTA güncellemeleri (mobile-app/OTA_GUNCELLEME.md) ---------
# Boşsa güncelleme yayınlama kapalıdır. En az 24 karakter, rastgele bir değer:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Aynı değer bilgisayarınızda mobile-app/.env.local içinde GELDESAT_OTA_TOKEN olarak durur.
OTA_PUBLISH_TOKEN=

# --- Yalnızca docker compose ile kurulumda -----------------------------------
POSTGRES_PASSWORD=
GELDESAT_PORT=3000
