{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // `src/lib/db.ts` imports scripts/migration-plan.mjs; checkJs types the
    // implementation itself instead of a hand-written declaration beside it.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "server"
  ],
  "exclude": [
    "node_modules",
    "src/app",
    "src/actions",
    "src/middleware.ts",
    "src/auth.ts",
    "src/auth.config.ts",
    "src/lib/mail.ts",
    "src/lib/tokens.ts",
    "src/lib/data/transform*.js",
    "src/components/admin",
    "src/components/auth",
    "src/components/home",
    "src/components/listing/wizard",
    "src/components/listing/EditListingForm.tsx",
    "src/components/listing/FavoriteButton.tsx",
    "src/components/listing/ListingFilters.tsx",
    "src/components/listing/ListingGallery.tsx",
    "src/components/listing/ListingResults.tsx",
    "src/components/listing/MyListingsActions.tsx",
    "src/components/listing/ShareButton.tsx",
    "src/components/layout/MobileMenu.tsx",
    "src/components/layout/NotificationBell.tsx",
    "src/components/layout/UserNav.tsx",
    "src/components/message",
    "src/components/profile",
    "src/components/providers",
    "src/components/search",
    "src/components/ui/alert-dialog.tsx",
    "src/components/ui/carousel.tsx",
    "src/components/ui/drawer.tsx",
    "src/components/ui/form.tsx",
    "src/components/ui/sheet.tsx",
    "src/components/ui/skeleton.tsx",
    "src/components/ui/table.tsx"
  ]
}
