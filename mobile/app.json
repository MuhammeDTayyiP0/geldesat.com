{
  "expo": {
    "name": "geldesat.com",
    "slug": "muhammed-tayyip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "geldesat",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a4fd8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geldesat.app",
      "associatedDomains": ["applinks:www.geldesat.com"],
      "infoPlist": {
        "NSCameraUsageDescription": "İlan verirken fotoğraf çekebilmek için kamera izni gereklidir.",
        "NSPhotoLibraryUsageDescription": "İlan fotoğraflarınızı seçebilmek için galeri izni gereklidir."
      }
    },
    "android": {
      "package": "com.geldesat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1a4fd8"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.geldesat.com",
              "pathPrefix": "/ilan"
            },
            {
              "scheme": "geldesat"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a4fd8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İlan fotoğraflarınızı seçebilmek için galeri izni gereklidir.",
          "cameraPermission": "İlan verirken fotoğraf çekebilmek için kamera izni gereklidir."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bce724e-28c3-41d6-b0f1-575b126e86db"
      }
    },
    "owner": "thelouss-team"
  }
}
