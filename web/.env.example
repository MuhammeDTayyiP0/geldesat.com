# Opsiyonel. Boş bırakılırsa yerel PGLite (gömülü Postgres) kullanılır.
# Canlı ortamda gerçek Postgres / Neon bağlantısı verin.
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/geldesat

# Auth açık (varsayılan)
VITE_AUTH_ENABLED=true

# Yönetici hesapları (virgülle ayrılmış). Yalnızca doğrulanmış e-postalar
# (ör. Google ile giriş) yönetici olur. Alternatif: SQL ile
#   update profiles set role='ADMIN' where user_id='...';
ADMIN_EMAILS=
